{{!
    @template local_learningprism/notebook_banner

    Course-page Google Notebook status and links.

    Example context (json):
    {
        "heading": "Google Notebook",
        "statuslabel": "Uploading sources",
        "manageurl": "http://localhost/local/learningprism/notebook.php?id=4",
        "managelabel": "Notebook settings",
        "url": "https://notebook.cloud.google.com/eu/notebook/abc?project=123",
        "openlabel": "Open Google Notebook"
    }
}}
<div class="local-learningprism-notebook alert alert-info" role="region" aria-label="{{heading}}">
    <strong>{{heading}}</strong>
    {{#statuslabel}}<span class="lp-notebook-status">{{statuslabel}}</span>{{/statuslabel}}
    {{#manageurl}}
        <a class="btn btn-secondary btn-sm" href="{{manageurl}}">{{managelabel}}</a>
    {{/manageurl}}
    {{#url}}
        <a class="btn btn-primary btn-sm" href="{{url}}" target="_blank" rel="noopener noreferrer">{{openlabel}}</a>
    {{/url}}
</div>
