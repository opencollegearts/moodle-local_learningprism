    @template local_learningprism/modal_body

    Modal body for request/download.

    Example context (json):
    {
        "name": "Week 1",
        "state": "request",
        "showrequest": true,
        "showdownload": false,
        "showpersonal": true,
        "canmanage": true,
        "requestlabel": "Request or regenerate selected",
        "formats": [{"format":"docx","label":"DOCX","isnone":true,"supportspersonal":true}],
        "backgrounds": [{"key":"white","label":"White","selected":true}],
        "fonts": [{"key":"default","label":"Default","selected":true}]
    }
}}
<div class="local-learningprism-modal">
    <p class="mb-2"><strong>{{name}}</strong></p>
    <p class="mb-3">{{#str}} modal:selectformats, local_learningprism {{/str}}</p>
    <ul class="list-unstyled">
        {{#formats}}
            <li class="mb-3">
                <label class="d-flex align-items-center gap-2 flex-wrap">
                    <input type="checkbox" name="lpformat" value="{{format}}"
                        {{#isnone}}checked{{/isnone}}
                        {{#iserror}}checked{{/iserror}}
                        {{#ispersonalnone}}checked{{/ispersonalnone}}
                        {{#ispersonalerror}}checked{{/ispersonalerror}}
                        {{#lockcheckbox}}disabled{{/lockcheckbox}} />
                    <span>{{label}}</span>
                    <span class="badge bg-secondary text-dark">{{status}}</span>
                    {{#isready}}
                        <a href="#" data-action="lp-download" data-format="{{format}}">{{#str}} modal:download, local_learningprism {{/str}}</a>
                    {{/isready}}
                    {{#iserror}}
                        <span class="text-danger small">{{errorinfo}}</span>
                    {{/iserror}}
                </label>
                {{#supportspersonal}}
                    <div class="pl-4 ml-1 small text-muted">
                        {{#str}} modal:yourversion, local_learningprism {{/str}}
                        <span class="badge bg-light text-dark">{{personalstatus}}</span>
                        {{#ispersonalready}}
                            <a href="#" data-action="lp-download-personal" data-format="{{format}}">{{#str}} modal:downloadmine, local_learningprism {{/str}}</a>
                        {{/ispersonalready}}
                        {{#ispersonalerror}}
                            <span class="text-danger">{{personalerrorinfo}}</span>
                        {{/ispersonalerror}}
                    </div>
                {{/supportspersonal}}
            </li>
        {{/formats}}
    </ul>
    {{#showpersonal}}
        <fieldset class="mb-3 p-3 border">
            <legend class="h6">{{#str}} modal:myoptions, local_learningprism {{/str}}</legend>
            <p class="small">{{#str}} modal:myoptions_help, local_learningprism {{/str}}</p>
            <div class="form-group">
                <label for="lpbackground">{{#str}} settings:printbackground, local_learningprism {{/str}}</label>
                <select id="lpbackground" name="lpbackground" class="custom-select">
                    {{#backgrounds}}
                        <option value="{{key}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/backgrounds}}
                </select>
            </div>
            <div class="form-group">
                <label for="lpfont">{{#str}} settings:font, local_learningprism {{/str}}</label>
                <select id="lpfont" name="lpfont" class="custom-select">
                    {{#fonts}}
                        <option value="{{key}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/fonts}}
                </select>
            </div>
            <button type="button" class="btn btn-outline-primary" data-action="lp-request-personal">
                {{#str}} modal:requestmine, local_learningprism {{/str}}
            </button>
        </fieldset>
    {{/showpersonal}}
    <div class="mt-3 lp-actions">
        {{#showrequest}}
            <button type="button" class="btn btn-primary" data-action="lp-request">
                {{requestlabel}}
            </button>
        {{/showrequest}}
        {{#showdownload}}
            <button type="button" class="btn btn-primary" data-action="lp-download" data-format="">
                {{#str}} modal:download, local_learningprism {{/str}}
            </button>
        {{/showdownload}}
        {{#canmanage}}
            <button type="button" class="btn btn-secondary" data-action="lp-pregenerate">
                {{#str}} modal:pregenerate, local_learningprism {{/str}}
            </button>
        {{/canmanage}}
    </div>
</div>
